  "item": [
    {
      "name": "Book ISBN Numbers",
      "item": [
        {
          "name": "Is Valid ISBN13 Number",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "let responseBody = pm.response.text();",
                  "let jsonResponse = xml2Json(responseBody);",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type is text/xml\", function() {",
                  "    pm.expect(pm.response.headers.get(\"Content-type\")).to.include(\"text/xml\");",
                  "})",
                  "pm.test(\"ISBN is real\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"true\");",
                  "});",
                  "pm.test(\"Response contains attribute xmlns:soap\", function(){",
                  "    pm.expect(jsonResponse[\"soap:Envelope\"].$[\"xmlns:soap\"]).to.include(\"http://schemas.xmlsoap.org/soap/envelope/\");",
                  "});",
                  "",
                  "pm.test(\"Response contains attribute IsValidISBN13Response\", function() {",
                  "    pm.expect(jsonResponse[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN13Response\"].$[\"xmlns:m\"]).to.include(\"http://webservices.daehosting.com/ISBN\");",
                  "});",
                  "pm.test(\"Response attribute m:IsValidISBN13Reult is not empty \", function() {",
                  "    pm.expect(jsonResponse[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN13Response\"][\"m:IsValidISBN13Result\"]).not.to.be.empty;",
                  "});",
                  "",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
            },
            "url": {
              "raw": "http://webservices.daehosting.com/services/isbnservice.wso",
              "protocol": "http",
              "host": [
                "webservices",
                "daehosting",
                "com"
              ],
              "path": [
                "services",
                "isbnservice.wso"
              ]
            },
            "description": "The test is done by calculation on the first 12 digits and compare the result with the checksum number at the end. You have to pass a 13 digits number."
          },
          "response": []
        },
